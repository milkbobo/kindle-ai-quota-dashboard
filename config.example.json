{
  "outputDir": "state",
  "keepLocalHistory": false,
  "displayProviders": ["codex", "zai"],
  "quoteFile": "config/quote.json",
  "weatherFile": "",
  "providers": {
    "zai": {
      "enabled": false,
      "apiKeyEnv": "ZAI_API_KEY",
      "baseUrl": "https://api.z.ai"
    },
    "deepseek": {
      "enabled": false,
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "openai": {
      "enabled": false,
      "apiKeyEnv": "OPENAI_API_KEY",
      "baseUrl": "https://api.openai.com",
      "monthlyBudgetUsd": 0,
      "proxy": ""
    },
    "claude": {
      "enabled": false,
      "experimental": true,
      "allowLocalCredentialRead": false,
      "credentialsFile": "~/.claude/.credentials.json"
    },
    "codex": {
      "enabled": false,
      "experimental": true,
      "executableEnv": "CODEX_CLI_PATH"
    },
    "kimi": {
      "enabled": false,
      "experimental": true,
      "allowLocalCredentialRead": false,
      "credentialsFile": "~/.kimi-code/credentials/kimi-code.json",
      "baseUrl": "https://api.kimi.com/coding/v1"
    }
  }
}
