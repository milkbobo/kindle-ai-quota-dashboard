{
  "name": "kindle-ai-quota-dashboard",
  "version": "0.1.1",
  "private": true,
  "description": "把本机 AI 服务额度安全地显示在越狱 Kindle 上。",
  "license": "MIT",
  "author": "Kindle AI Quota Dashboard contributors",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "preview:koreader": "node scripts/preview-koreader.cjs",
    "demo": "node src/collect.cjs --demo",
    "collect": "node src/collect.cjs",
    "build": "node scripts/build-site.cjs",
    "deploy": "node scripts/deploy-pages.cjs",
    "serve": "node scripts/serve.cjs",
    "package:kindle": "node scripts/build-kpkg.cjs",
    "test": "node --test tests/core.test.cjs",
    "check": "node scripts/check-public.cjs && node --test tests/core.test.cjs",
    "refresh": "node src/collect.cjs && node scripts/export-kindle.cjs && node scripts/render-png.cjs && node scripts/deploy-pages.cjs",
    "refresh:watch": "node scripts/refresh-watch.cjs",
    "watch": "node scripts/refresh-watch.cjs 2"
  }
}
